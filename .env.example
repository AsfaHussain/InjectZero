# =============================================================================
# InjectZero — AI Security Gateway
# Copy this file to .env and fill in your values
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# LLM Provider — set to "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyAdEMMc1o2LQoSuV4vd6qp2DPcs2wZnW_s





# Gemini Model (only used when LLM_PROVIDER=gemini)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Risk threshold — requests scoring above this value are blocked (0.0 – 1.0)
RISK_THRESHOLD=0.7

# Vector similarity threshold — cosine sim above this is treated as an attack
VECTOR_SIMILARITY_THRESHOLD=0.75

# Gateway base URL (used by the agent simulator)
GATEWAY_URL=http://localhost:3000
